---
/**
 * Optional hover/pin panel for the inline `[n]` citation markers that the
 * `remarkCitation` adapter emits. The markers are real anchor links to the
 * on-page "References" list and work with no JavaScript; this island only
 * adds a quick look at the source without leaving the reader's place.
 */
import { getCollection } from 'astro:content';
import {
  formatReferenceText,
  formatSourceLabel,
} from '../../notation/citation-format.mjs';

const sources = await getCollection('sources');

const records = Object.fromEntries(
  sources.map((entry) => [
    entry.data.id,
    {
      label: formatSourceLabel(entry.data),
      reference: formatReferenceText(entry.data, undefined),
      url: typeof entry.data.url === 'string' ? entry.data.url : '',
      status: entry.data.editorialStatus,
    },
  ]),
);
---

<aside
  class="citation-panel"
  id="citation-panel"
  data-citation-panel
  role="region"
  aria-label="Source citation"
  aria-live="polite"
  aria-atomic="true"
  hidden
>
  <p class="citation-panel-label" data-panel-label></p>
  <p class="citation-panel-locator" data-panel-locator hidden></p>
  <p class="citation-panel-status" data-panel-status hidden></p>
  <a class="citation-panel-link" data-panel-link hidden>Open source link</a>
  <a class="citation-panel-jump" data-panel-jump>See it in the reference list</a
  >
  <button
    class="citation-panel-pin"
    type="button"
    data-panel-pin
    aria-pressed="false"
  >
    Pin
  </button>
</aside>

<script
  is:inline
  type="application/json"
  data-citation-records
  set:html={JSON.stringify(records)}
/>

<script>
  interface CitationRecord {
    label: string;
    reference: string;
    url: string;
    status: 'draft' | 'in-review' | 'reviewed';
  }

  function setup() {
    const dataNode = document.querySelector<HTMLScriptElement>(
      '[data-citation-records]',
    );
    const panel = document.querySelector<HTMLElement>('[data-citation-panel]');
    if (!dataNode || !panel || panel.dataset.ready === 'true') return;

    let records: Record<string, CitationRecord>;
    try {
      records = JSON.parse(dataNode.textContent ?? '{}');
    } catch {
      return;
    }

    const markers = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(
        '.sl-markdown-content a.citation-ref[data-citation-id]',
      ),
    );
    if (markers.length === 0) return;
    panel.dataset.ready = 'true';

    const label = panel.querySelector<HTMLElement>('[data-panel-label]')!;
    const locator = panel.querySelector<HTMLElement>('[data-panel-locator]')!;
    const status = panel.querySelector<HTMLElement>('[data-panel-status]')!;
    const link = panel.querySelector<HTMLAnchorElement>('[data-panel-link]')!;
    const jump = panel.querySelector<HTMLAnchorElement>('[data-panel-jump]')!;
    const pin = panel.querySelector<HTMLButtonElement>('[data-panel-pin]')!;

    let activeAnchor: HTMLElement | null = null;
    let pinned = false;

    const place = () => {
      if (panel.hidden || !activeAnchor) return;
      const edge = 12;
      const gap = 8;
      const rect = activeAnchor.getBoundingClientRect();
      panel.style.maxHeight = '';
      const panelRect = panel.getBoundingClientRect();
      const below = window.innerHeight - rect.bottom - gap - edge;
      const placeBelow = below >= panelRect.height || below >= rect.top;
      let top = placeBelow
        ? rect.bottom + gap
        : rect.top - gap - panelRect.height;
      let left = rect.left + rect.width / 2 - panelRect.width / 2;

      // Keep the panel within the article column so it never lands under the
      // navigation rail or the page sidebar.
      const article = document.querySelector<HTMLElement>(
        '.sl-markdown-content',
      );
      const bounds = article?.getBoundingClientRect();
      const minLeft = Math.max(edge, bounds?.left ?? edge);
      const maxLeft = Math.min(
        window.innerWidth - edge,
        bounds?.right ?? window.innerWidth - edge,
      );
      left =
        maxLeft - minLeft >= panelRect.width
          ? Math.max(minLeft, Math.min(left, maxLeft - panelRect.width))
          : Math.max(
              edge,
              Math.min(left, window.innerWidth - panelRect.width - edge),
            );

      const headerBottom =
        document
          .querySelector<HTMLElement>('header.header')
          ?.getBoundingClientRect().bottom ?? 0;
      top = Math.max(
        Math.max(edge, headerBottom + edge),
        Math.min(top, window.innerHeight - panelRect.height - edge),
      );
      panel.style.top = `${Math.round(top)}px`;
      panel.style.left = `${Math.round(left)}px`;
    };

    const show = (anchor: HTMLElement) => {
      const id = anchor.dataset.citationId ?? '';
      const record = records[id];
      if (!record) return;
      activeAnchor = anchor;

      label.textContent = record.label;

      const loc = anchor.dataset.citationLocator ?? '';
      locator.textContent = loc;
      locator.hidden = loc.length === 0;

      const showStatus = record.status && record.status !== 'reviewed';
      status.textContent = showStatus ? `Source record: ${record.status}` : '';
      status.hidden = !showStatus;

      if (record.url) {
        link.href = record.url;
        link.hidden = false;
      } else {
        link.hidden = true;
      }

      jump.href = anchor.getAttribute('href') ?? '#references';

      panel.style.visibility = 'hidden';
      panel.hidden = false;
      place();
      panel.style.visibility = 'visible';
    };

    const close = () => {
      panel.hidden = true;
      activeAnchor = null;
      pinned = false;
      pin.setAttribute('aria-pressed', 'false');
      pin.textContent = 'Pin';
    };

    const hideUnlessPinned = () => {
      window.requestAnimationFrame(() => {
        if (pinned) return;
        if (panel.matches(':hover') || activeAnchor?.matches(':hover')) return;
        if (panel.contains(document.activeElement)) return;
        panel.hidden = true;
        activeAnchor = null;
      });
    };

    for (const marker of markers) {
      marker.addEventListener('pointerenter', () => {
        if (!pinned) show(marker);
      });
      marker.addEventListener('pointerleave', hideUnlessPinned);
      marker.addEventListener('focus', () => show(marker));
      marker.addEventListener('blur', hideUnlessPinned);
    }

    panel.addEventListener('pointerleave', hideUnlessPinned);
    pin.addEventListener('click', () => {
      pinned = !pinned;
      pin.setAttribute('aria-pressed', String(pinned));
      pin.textContent = pinned ? 'Unpin' : 'Pin';
      if (!pinned) hideUnlessPinned();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) close();
    });
    document.addEventListener('pointerdown', (event) => {
      if (!pinned || panel.hidden) return;
      const target = event.target;
      if (target instanceof Node && panel.contains(target)) return;
      if (target instanceof Element && target.closest('a.citation-ref')) return;
      close();
    });

    window.addEventListener('resize', place, { passive: true });
    window.addEventListener('scroll', place, { passive: true, capture: true });
  }

  setup();
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  @layer starlight.components {
    .citation-panel {
      position: fixed;
      z-index: 100;
      width: min(22rem, calc(100vw - 1.5rem));
      padding: 0.9rem 1rem;
      border: 1px solid var(--sl-color-gray-5);
      border-top: 0.25rem solid var(--sl-color-accent);
      border-radius: 0.6rem;
      background: var(--sl-color-bg);
      color: var(--sl-color-text);
      box-shadow: var(--sl-shadow-lg);
      font-size: var(--sl-text-sm);
    }

    .citation-panel p {
      margin: 0 0 0.5rem;
      line-height: 1.5;
    }

    .citation-panel-label {
      font-weight: 600;
    }

    .citation-panel-locator {
      color: var(--sl-color-gray-2);
    }

    .citation-panel-status {
      color: var(--sl-color-gray-3);
      font-size: var(--sl-text-xs);
      text-transform: lowercase;
    }

    .citation-panel-link,
    .citation-panel-jump {
      display: inline-block;
      margin-inline-end: 0.9rem;
      font-size: var(--sl-text-xs);
    }

    .citation-panel-pin {
      display: block;
      margin-top: 0.6rem;
      padding: 0.2rem 0.6rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.35rem;
      background: var(--sl-color-bg);
      color: var(--sl-color-text-accent);
      font: inherit;
      font-size: var(--sl-text-xs);
      cursor: pointer;
    }

    .citation-panel-pin[aria-pressed='true'] {
      border-color: var(--sl-color-accent);
      background: var(--sl-color-accent-low);
    }

    .citation-panel :focus-visible {
      outline: 3px solid var(--sl-color-accent);
      outline-offset: 2px;
    }
  }
</style>
