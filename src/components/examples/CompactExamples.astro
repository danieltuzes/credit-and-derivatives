---
interface Props {
  /** Text shown on the native disclosure while the examples are collapsed. */
  summary?: string;
  /** Optional one-line cue below the disclosure title. */
  hint?: string;
  /** Accessible name for the tab list created by progressive enhancement. */
  tabsLabel?: string;
}

const {
  summary = 'Worked examples',
  hint = 'Open and choose an example.',
  tabsLabel = summary,
} = Astro.props;
---

<compact-examples data-tabs-label={tabsLabel}>
  <details class="compact-examples">
    <summary class="compact-examples__summary">
      <span class="compact-examples__title">{summary}</span>
      {hint && <span class="compact-examples__hint">{hint}</span>}
    </summary>
    <div class="compact-examples__body">
      <slot />
    </div>
  </details>
</compact-examples>

<style>
  compact-examples {
    display: block;
    margin-block: 1.5rem;
  }

  .compact-examples {
    overflow: clip;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-gray-7);
  }

  .compact-examples__summary {
    padding: 0.8rem 1rem;
    cursor: pointer;
  }

  .compact-examples__summary::marker {
    color: var(--sl-color-text-accent);
  }

  .compact-examples__summary:focus-visible {
    outline: 3px solid var(--sl-color-accent);
    outline-offset: -3px;
  }

  .compact-examples__title {
    font-weight: 700;
  }

  .compact-examples__hint {
    display: block;
    margin-block-start: 0.15rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .compact-examples__body {
    padding: 0.25rem 1rem 1rem;
    border-block-start: 1px solid var(--sl-color-gray-5);
  }

  :global(.compact-examples__tabs) {
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
    margin: 0 -1rem 1rem;
    padding: 0.55rem 1rem 0;
    border-block-end: 1px solid var(--sl-color-gray-5);
  }

  :global(.compact-examples__tab) {
    flex: 0 0 auto;
    padding: 0.45rem 0.7rem;
    color: var(--sl-color-gray-3);
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
    cursor: pointer;
    border: 0;
    border-block-end: 3px solid transparent;
    background: transparent;
  }

  :global(.compact-examples__tab[aria-selected='true']) {
    color: var(--sl-color-text-accent);
    border-block-end-color: var(--sl-color-text-accent);
  }

  :global(.compact-examples__tab:focus-visible) {
    outline: 3px solid var(--sl-color-accent);
    outline-offset: -3px;
  }

  :global(.compact-example[role='tabpanel']) {
    margin: 0;
  }

  @media print {
    .compact-examples {
      overflow: visible;
      border: 0;
      background: transparent;
    }

    .compact-examples__summary,
    :global(.compact-examples__tabs) {
      display: none;
    }

    .compact-examples__body {
      display: block !important;
      padding: 0;
      border: 0;
    }

    :global(.compact-example[hidden]) {
      display: block !important;
    }

    :global(.compact-example + .compact-example) {
      margin-block-start: 1.5rem;
    }

    :global(.compact-example__heading[hidden]) {
      display: block !important;
    }
  }
</style>

<script>
  class CompactExamplesElement extends HTMLElement {
    static nextId = 0;

    connectedCallback() {
      if (this.dataset.enhanced === 'true') return;

      const details =
        this.querySelector<HTMLDetailsElement>(':scope > details');
      const body = details?.querySelector<HTMLElement>(
        ':scope > .compact-examples__body',
      );
      if (!details || !body) return;

      const panels = Array.from(
        body.querySelectorAll<HTMLElement>(':scope > [data-compact-example]'),
      );
      if (panels.length < 2) return;

      this.dataset.enhanced = 'true';
      const instanceId = `compact-examples-${CompactExamplesElement.nextId++}`;
      const tablist = document.createElement('div');
      tablist.className = 'compact-examples__tabs';
      tablist.setAttribute('role', 'tablist');
      tablist.setAttribute(
        'aria-label',
        this.dataset.tabsLabel || 'Worked examples',
      );

      const tabs = panels.map((panel, index) => {
        const label = panel.dataset.exampleLabel || `Example ${index + 1}`;
        const panelId = panel.id || `${instanceId}-panel-${index + 1}`;
        const tabId = `${instanceId}-tab-${index + 1}`;
        panel.id = panelId;
        panel.setAttribute('role', 'tabpanel');
        panel.setAttribute('aria-labelledby', tabId);

        const heading = panel.querySelector<HTMLElement>(
          ':scope > .compact-example__heading',
        );
        if (heading) heading.hidden = true;

        const tab = document.createElement('button');
        tab.type = 'button';
        tab.className = 'compact-examples__tab';
        tab.id = tabId;
        tab.textContent = label;
        tab.setAttribute('role', 'tab');
        tab.setAttribute('aria-controls', panelId);
        tablist.append(tab);
        return tab;
      });

      const activate = (activeIndex: number, moveFocus = false) => {
        tabs.forEach((tab, index) => {
          const selected = index === activeIndex;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
          panels[index].hidden = !selected;
        });
        if (moveFocus) tabs[activeIndex].focus();
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => activate(index));
        tab.addEventListener('keydown', (event) => {
          let nextIndex: number | undefined;
          if (event.key === 'ArrowLeft') {
            nextIndex = (index - 1 + tabs.length) % tabs.length;
          } else if (event.key === 'ArrowRight') {
            nextIndex = (index + 1) % tabs.length;
          } else if (event.key === 'Home') {
            nextIndex = 0;
          } else if (event.key === 'End') {
            nextIndex = tabs.length - 1;
          }

          if (nextIndex === undefined) return;
          event.preventDefault();
          activate(nextIndex, true);
        });
      });

      body.prepend(tablist);
      activate(0);

      let openBeforePrint: boolean | undefined;
      const enterPrintMode = () => {
        if (openBeforePrint !== undefined) return;
        openBeforePrint = details.open;
        details.open = true;
      };
      const leavePrintMode = () => {
        if (openBeforePrint === undefined) return;
        details.open = openBeforePrint;
        openBeforePrint = undefined;
      };
      const printMedia = window.matchMedia('print');
      printMedia.addEventListener('change', (event) => {
        if (event.matches) enterPrintMode();
        else leavePrintMode();
      });
      window.addEventListener('beforeprint', enterPrintMode);
      window.addEventListener('afterprint', leavePrintMode);
      if (printMedia.matches) enterPrintMode();
    }
  }

  if (!customElements.get('compact-examples')) {
    customElements.define('compact-examples', CompactExamplesElement);
  }
</script>
