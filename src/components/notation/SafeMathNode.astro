---
import type { SafeMathNode as Node } from './render-notation-math';
import SafeMathNode from './SafeMathNode.astro';

interface Props {
  node: Node;
}

const { node } = Astro.props;
const Element = node.type === 'element' ? node.tagName : undefined;
---

{
  node.type === 'text'
    ? node.value
    : Element && (
        <Element {...node.properties}>
          {node.children.map((child) => (
            <SafeMathNode node={child} />
          ))}
        </Element>
      )
}
