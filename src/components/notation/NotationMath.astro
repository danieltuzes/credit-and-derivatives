---
import { renderNotationMath } from './render-notation-math';
import SafeMathNode from './SafeMathNode.astro';

interface Props {
  latex: string;
  class?: string;
}

const { latex, class: className } = Astro.props;
const nodes = renderNotationMath(latex);
---

<span class:list={['notation-math', className]} data-notation-math>
  {nodes.map((node) => <SafeMathNode node={node} />)}
</span>

<style>
  .notation-math :global(.katex) {
    /* Compact labels inherit their surrounding text size. KaTeX's own sizing
       classes retain the smaller scale for subscripts and superscripts. */
    font-size: 1em;
  }
</style>
