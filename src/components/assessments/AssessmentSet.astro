---
import { getCollection } from 'astro:content';
import { loadManifest } from '../../content/manifest';
import AssessmentRunner from './AssessmentRunner';

interface Props {
  /**
   * Explicit assessment id. Omitted in lesson bodies (Phase C2): the set is
   * resolved from the route's colocated `<lesson>.checks.yml` via the manifest.
   */
  id?: string;
}

const explicitId = Astro.props.id;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lessonId = Astro.url.pathname
  .replace(new RegExp(`^${base}/`), '')
  .replace(/\/$/, '')
  .replace(/\//g, '.');

let ids: string[];
if (explicitId) {
  ids = [explicitId];
} else {
  const manifest = await loadManifest();
  ids = [
    ...(manifest.lessons.find((lesson) => lesson.id === lessonId)
      ?.assessments ?? []),
  ];
}

const assessments = await getCollection('assessments');
const entries = ids.map((id) => {
  const entry = assessments.find((candidate) => candidate.data.id === id);
  if (!entry) {
    throw new Error(
      `AssessmentSet: no assessment collection entry with id "${id}"`,
    );
  }
  return entry;
});
---

{
  entries.map((entry) => (
    <AssessmentRunner
      client:visible
      title={entry.data.title}
      items={entry.data.items}
    />
  ))
}
