---
import { Icon } from '@astrojs/starlight/components';
import DefaultSidebar from '@astrojs/starlight/components/Sidebar.astro';
---

<div class="layout-navigation-panel" data-layout-panel="navigation">
  <button
    class="layout-edge-toggle layout-navigation-toggle"
    type="button"
    aria-controls="starlight__navigation-content"
    aria-expanded="true"
    data-layout-toggle="navigation"
    hidden
  >
    <Icon
      name="left-caret"
      class="layout-edge-icon layout-edge-icon-hide"
      size="1rem"
    />
    <Icon
      name="right-caret"
      class="layout-edge-icon layout-edge-icon-restore"
      size="1rem"
    />
  </button>
  <div id="starlight__navigation-content" class="layout-navigation-content">
    <DefaultSidebar />
  </div>
</div>
