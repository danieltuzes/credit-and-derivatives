---
/**
 * Starlight only allows one `Footer` override, so this component composes the
 * page-notation layer and the source-citation layer ahead of Starlight's own
 * footer. Both layers are optional progressive enhancements over static
 * markup that the remark adapters and the content collections already emit.
 */
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
import { loadNotationRegistryInput } from '../../../scripts/notation-files';
import {
  assertValidNotation,
  buildNotationRegistry,
} from '../../notation/registry';
import NotationLayer, {
  type NotationLayerDefinition,
} from '../notation/NotationLayer.astro';
import CitationLayer from '../citation/CitationLayer.astro';

const routeData = Astro.locals.starlightRoute.entry
  .data as typeof Astro.locals.starlightRoute.entry.data & {
  lessonId?: string;
};

const definitions: NotationLayerDefinition[] = [];
if (routeData.lessonId) {
  const registry = buildNotationRegistry(await loadNotationRegistryInput());
  assertValidNotation(registry);

  const bundle = registry.bundles.find(
    ({ lessonId }) => lessonId === routeData.lessonId,
  );
  const definitionsById = new Map(
    registry.definitions.map((definition) => [definition.id, definition]),
  );
  for (const definitionId of bundle?.definitionIds ?? []) {
    const definition = definitionsById.get(definitionId);
    if (!definition) continue;

    if (definition.kind === 'shared') {
      definitions.push({
        key: definition.key,
        notation: definition.notation,
        title: definition.title,
        summary: definition.summary,
        details: definition.perspective,
        units: definition.units,
        seeAlso: definition.seeAlso,
        editorialStatus: definition.status,
        scope: 'shared',
        href: `/glossary/#notation-${definition.key}`,
      });
      continue;
    }

    definitions.push({
      key: definition.key,
      notation: definition.notation,
      title: definition.title,
      summary: definition.summary,
      details: definition.details,
      formula: definition.formula,
      units: definition.units,
      seeAlso: definition.seeAlso,
      editorialStatus: definition.status,
      scope: 'local',
      href: `#notation-${definition.key}`,
    });
  }
}
---

<NotationLayer definitions={definitions} />
{routeData.lessonId && <CitationLayer />}
<DefaultFooter />
