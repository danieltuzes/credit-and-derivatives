---
import { labMathScope } from 'explico/reference/lab-math-scope';
import {
  renderLabMath,
  type RenderedLabMath,
} from 'explico/reference/render-lab-math';
import { DiscountingTools, DISCOUNTING_LAB_MATH } from './DiscountingExplorer';

// The discounting figure's tools (its `tools` slot): the two formulas are
// rendered here, at build time, against the page's notation, and the island
// only patches numbers into them. The plot is the figure's picture,
// `DiscountingPlot`, which the lesson places itself.

type TemplateId = keyof typeof DISCOUNTING_LAB_MATH;

const entry = Astro.locals.starlightRoute.entry;
const routeData = entry.data as {
  notation?: {
    local?: Array<{ key: string; latex: string }>;
  };
};

const scope = await labMathScope(routeData.notation, entry.body ?? '');

const math = {} as Record<TemplateId, RenderedLabMath>;
for (const id of Object.keys(DISCOUNTING_LAB_MATH) as TemplateId[]) {
  math[id] = renderLabMath(DISCOUNTING_LAB_MATH[id], scope);
}
---

<DiscountingTools client:visible math={math} />
