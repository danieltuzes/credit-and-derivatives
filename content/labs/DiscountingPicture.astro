---
import {
  DISCOUNTING_DEFAULTS,
  DiscountingPlot,
  discountingPlotOptions,
} from './DiscountingExplorer';
import { stillPlot } from './still-plot';

// The discounting figure's picture (its default slot): the plot island, with
// the plot at the lab's defaults drawn here at build time (rule V3). The
// island shows this copy until it has drawn its own, so the page has the
// chart without JavaScript too. The tools are `DiscountingExplorerMath.astro`.
const still = stillPlot(discountingPlotOptions(DISCOUNTING_DEFAULTS));
---

<DiscountingPlot client:visible><Fragment set:html={still} /></DiscountingPlot>
