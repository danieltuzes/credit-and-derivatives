---
/**
 * Shared hover/pin panel shell for the notation and citation layers.
 *
 * This component contributes only the fixed-position `<aside>` container and
 * its base styling. The interaction engine — side selection, the sticky-header
 * and article-column clamps, pin, Escape, and outside-close — lives once in
 * `./hover-panel.ts` and is wired from each layer's island script. The panel's
 * inner fields are slotted by the layer that owns them.
 *
 * Extra attributes (e.g. `data-notation-panel`, `data-citation-panel`) are
 * forwarded to the `<aside>` so each layer keeps the hook its tests and pin
 * controls already reference.
 *
 * `tabindex="-1"`: never in the tab order, but a valid target for
 * `panel.focus()`. A layer that lets the reader click deeper into the panel's
 * own content (D15's in-panel navigation) needs somewhere stable to move
 * focus to before it replaces whatever the reader just clicked — otherwise
 * removing the focused node drops focus to nothing, and the shared
 * `focusout` handler in `./hover-panel.ts` reads that as "the reader left"
 * and closes the panel it was just asked to update.
 */
export interface Props {
  /** Element id — pin controls point `aria-controls` at it. */
  id: string;
  /** Accessible name for the region. */
  label: string;
  class?: string;
}

const { id, label, class: className, ...rest } = Astro.props;
---

<aside
  class:list={['hover-panel', className]}
  id={id}
  role="region"
  aria-label={label}
  aria-live="polite"
  aria-atomic="true"
  hidden
  tabindex="-1"
  {...rest}
>
  <button
    class="hover-panel-close"
    type="button"
    data-hover-panel-close
    aria-label="Close"
  >
    <span aria-hidden="true">&times;</span>
  </button>
  <slot />
</aside>

<style>
  @layer starlight.components {
    .hover-panel {
      position: fixed;
      z-index: 100;
      /* The panel is an <aside> in the content flow; a stray cascade margin
         would offset a position:fixed box from its computed `top`, so the
         JS placement (which clears display equations) must start from zero. */
      margin: 0;
      width: min(23rem, calc(100vw - 1.5rem));
      overflow: auto;
      padding: 1rem;
      padding-inline-end: 2.4rem;
      border: 1px solid var(--sl-color-gray-5);
      border-top: 0.25rem solid var(--sl-color-accent);
      border-radius: 0.65rem;
      color: var(--sl-color-text);
      background: var(--sl-color-bg);
      box-shadow: var(--sl-shadow-lg);
      font-size: var(--sl-text-sm);
    }

    .hover-panel-close {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      width: 1.6rem;
      height: 1.6rem;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      border: 0;
      border-radius: 0.35rem;
      color: var(--sl-color-gray-3);
      background: transparent;
      font-size: 1.15rem;
      line-height: 1;
      cursor: pointer;
    }

    .hover-panel-close:hover {
      color: var(--sl-color-text);
      background: var(--sl-color-gray-6);
    }

    /* Slotted fields carry the owning layer's scope, not this component's, so
       the descendant match must be global. */
    .hover-panel :global(:focus-visible) {
      outline: 3px solid var(--sl-color-accent);
      outline-offset: 2px;
    }
  }
</style>
