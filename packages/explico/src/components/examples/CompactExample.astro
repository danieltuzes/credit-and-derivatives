---
interface Props {
  /** Short, descriptive tab label, for example “Mixed signed cash flows”. */
  label: string;
  /** Optional stable anchor for linking directly to this example. */
  id?: string;
}

const { label, id } = Astro.props;

if (typeof label !== 'string' || !label.trim()) {
  throw new Error('CompactExample requires a non-empty `label` prop.');
}
---

<section
  class="compact-example"
  data-compact-example
  data-example-label={label}
  id={id}
>
  <h3 class="compact-example__heading">{label}</h3>
  <slot />
</section>

<style>
  .compact-example__heading {
    margin-block-start: 0;
  }

  .compact-example > :last-child {
    margin-block-end: 0;
  }
</style>
