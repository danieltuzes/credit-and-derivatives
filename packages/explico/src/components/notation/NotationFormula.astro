---
/**
 * A notation entry's rigorous `formula`, rendered with every glyph bound to a
 * key so the reader can point at any symbol in it and get an explanation
 * (D15).
 *
 * The formula resolves against the **entry-scoped** table from
 * `reference/gloss.ts` — the entry, its `glosses:`, and any card the formula
 * names with `\explain{key}{latex}` — not the registry-wide table a card's
 * body math uses.
 *
 * The gloss list under the formula is not decoration: a gloss has no card of
 * its own, so this list is where its name lives with JavaScript off. The hover
 * panel is enhancement layered over content that already reads.
 */
import NotationMath from './NotationMath.astro';
import SafeMathNode from './SafeMathNode.astro';
import { renderNotationFormula } from './render-notation-math';
import type { GlyphScopeEntry, ResolvedGloss } from '../../reference/gloss';

export interface Props {
  formula: string;
  scope: readonly GlyphScopeEntry[];
  glosses?: readonly ResolvedGloss[];
  /** Heading for the gloss list; omitted renders the list unlabelled. */
  glossLabel?: string;
  /** The owning entry's display label, used to name the scrollable region. */
  entryLabel?: string;
}

const {
  formula,
  scope,
  glosses = [],
  glossLabel = 'Symbols',
  entryLabel,
} = Astro.props;
const { nodes } = renderNotationFormula(formula, scope);
---

<div class="notation-formula-block">
  <div
    class="notation-formula-math"
    data-notation-formula
    role="group"
    aria-label={entryLabel ? `${entryLabel} formula` : 'Formula'}
    tabindex="0"
  >
    <span class="notation-math">
      {nodes.map((node) => <SafeMathNode node={node} />)}
    </span>
  </div>

  {
    glosses.length > 0 && (
      <dl class="notation-gloss-list" data-notation-gloss-list>
        {glossLabel && <dt class="notation-gloss-label">{glossLabel}</dt>}
        {glosses.map((gloss) => (
          <dd class="notation-gloss" data-notation-gloss={gloss.key}>
            <span
              class="notation-gloss-symbol"
              data-notation-symbol-trigger
              data-notation-key={gloss.key}
            >
              <NotationMath class="notation-symbol" latex={gloss.notation} />
            </span>
            <span class="notation-gloss-name">{gloss.label}</span>
            {gloss.units && (
              <span class="notation-gloss-units">({gloss.units})</span>
            )}
          </dd>
        ))}
      </dl>
    )
  }
</div>

<style>
  @layer starlight.components {
    .notation-formula-block {
      display: grid;
      gap: 0.5rem;
    }

    /* A wide equation scrolls inside its own box, which makes the box a
       scrollable region — and a scrollable region a keyboard user cannot reach
       is unreachable content, not just an awkward one. `tabindex` on the
       container is the fix; this is its focus ring. */
    .notation-formula-math {
      overflow-x: auto;
      padding-block: 0.15rem;
      color: var(--sl-color-text);
    }

    .notation-formula-math:focus-visible {
      outline: 3px solid var(--sl-color-accent);
      outline-offset: 2px;
    }

    .notation-gloss-list {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.25rem 1rem;
      margin: 0;
      color: var(--sl-color-gray-2);
      font-size: var(--sl-text-sm);
    }

    .notation-gloss-label {
      margin: 0;
      color: var(--sl-color-gray-3);
      font-weight: 600;
    }

    .notation-gloss {
      display: flex;
      align-items: baseline;
      gap: 0.35rem;
      margin: 0;
    }

    .notation-gloss-symbol {
      border-radius: 0.16em;
      color: var(--sl-color-accent-high);
      cursor: help;
    }

    .notation-gloss-symbol:hover,
    .notation-gloss-symbol:global(.is-notation-active) {
      background: var(--sl-color-accent-low);
      box-shadow: 0 0 0 0.12em var(--sl-color-accent-low);
    }

    .notation-gloss-name::before {
      content: '— ';
      color: var(--sl-color-gray-3);
    }

    .notation-gloss-units {
      color: var(--sl-color-gray-3);
    }

    @media (forced-colors: active) {
      .notation-gloss-symbol:hover,
      .notation-gloss-symbol:global(.is-notation-active) {
        outline: 2px solid Highlight;
        color: HighlightText;
        background: Highlight;
        box-shadow: none;
      }
    }
  }
</style>
