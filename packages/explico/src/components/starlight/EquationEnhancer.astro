---
/**
 * Progressive enhancement for keyed equations (Step D7).
 *
 * The no-JS baseline is complete: `remark-notation` emits a real `id="eq-<key>"`
 * container, a focusable number `<a>`, and `[[eq:key]]` renders a plain anchor;
 * `global.css` does the `:target` deep-link highlight (with a
 * `prefers-reduced-motion` fallback) and the sticky-header scroll offset via
 * `scroll-margin`.
 *
 * This script only adds what CSS and anchors cannot:
 *  - a smooth, header-aware scroll on an in-page jump;
 *  - re-triggering the highlight when the same `#eq-…` is activated again —
 *    the one case a plain anchor click does nothing for, since the browser
 *    won't navigate to a fragment that's already current;
 *  - moving keyboard focus onto the equation so screen-reader users land on it.
 *
 * It deliberately does *not* intercept an ordinary click that changes the
 * hash. `:target` is set only by a genuine same-document fragment
 * navigation — never by `history.pushState` (a common trap: pushState
 * updates the URL but leaves `:target`, and thus `eq-flash`, dark). Letting
 * the click through and reacting to the `hashchange` it produces is what
 * actually plays the highlight.
 *
 * Everything here is gated on `prefers-reduced-motion` and degrades to the
 * native anchor behaviour if it throws.
 */
---

<script>
  (() => {
    const root = document.querySelector('.sl-markdown-content');
    if (!root) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    const activate = (target: HTMLElement | null, doScroll: boolean) => {
      if (!target) return;
      if (!reduce.matches) {
        // Restart the CSS `:target` animation even when the hash is unchanged.
        target.style.animation = 'none';
        void target.offsetWidth;
        target.style.removeProperty('animation');
      }
      if (doScroll) {
        target.scrollIntoView({
          behavior: reduce.matches ? 'auto' : 'smooth',
          block: 'start',
        });
      }
      target.setAttribute('tabindex', '-1');
      try {
        target.focus({ preventScroll: true });
      } catch {
        target.focus();
      }
    };

    root.addEventListener('click', (event) => {
      const origin = event.target instanceof Element ? event.target : null;
      const link = origin?.closest('a.equation-ref, a.keyed-equation__number');
      if (!link) return;
      const href = link.getAttribute('href') || '';
      if (!href.startsWith('#eq-')) return; // cross-page: let the browser navigate
      const target = document.getElementById(href.slice(1));
      if (!target) return;
      // Only the already-on-this-anchor click needs handling here — the
      // browser has nothing new to navigate to, so it won't fire `hashchange`
      // and nothing else will re-trigger the flash. Every other click is left
      // alone: its native navigation sets `:target` and fires `hashchange`,
      // which the listener below turns into the same `activate()`.
      if (location.hash === href) {
        event.preventDefault();
        activate(target, true);
      }
    });

    window.addEventListener('hashchange', () => {
      if (!location.hash.startsWith('#eq-')) return;
      activate(document.getElementById(location.hash.slice(1)), true);
    });

    if (location.hash.startsWith('#eq-')) {
      activate(document.getElementById(location.hash.slice(1)), true);
    }
  })();
</script>
