{
  "name": "credit-products-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm validate:content && astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "validate:content": "tsx scripts/compile-manifest.ts",
    "content": "tsx scripts/content.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm validate:content && pnpm check && pnpm test && pnpm test:e2e && astro build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.4",
    "@astrojs/react": "6.0.4",
    "@astrojs/starlight": "0.41.9",
    "@observablehq/plot": "0.6.17",
    "astro": "7.2.7",
    "katex": "0.16.47",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "fast-check": "4.9.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "4.23.12",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  }
}
