node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
.output/

# Astro
.astro/

# Framework / bundler caches
.vite/
.cache/
*.tsbuildinfo

# Tests
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Deployment adapters (host still undecided)
.vercel/
.netlify/

# Environment: ignore real env files, keep the template
.env
.env.*
!.env.example

# Logs
*.log
logs/

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Editors — share a curated .vscode, ignore the rest
.idea/
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Temp
.tmp/
.temp/
*.local

# Reference library — copyrighted source PDFs/DjVu for author use only.
# Canonical copies live in the shared team library; this dir is a local cache.
# Cite works via src/content/sources/*.json (metadata only), never commit the files.
reference-library/*
!reference-library/README.md

# Compiler manifest (Phase D5) — regenerated by `pnpm validate:content`
.generated/
